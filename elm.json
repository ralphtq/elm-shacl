{
    "type": "package",
    "name": "ralphtq/elm-shacl",
    "summary": "SHACL types, shape dictionaries, and validation report types for Elm",
    "license": "MIT",
    "version": "1.1.0",
    "exposed-modules": [
        "SHACL.AST.Builder.Constraints",
        "SHACL.AST.Builder.Constraints.SHACLpredicates",
        "SHACL.InferenceShapeDictionary",
