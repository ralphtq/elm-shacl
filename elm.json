        "SHACL.SHACLtypes",
        "SHACL.ShapeDictionary",
        "SHACL.ValidationTypes"
    ],
    "elm-version": "0.19.0 <= v < 0.20.0",
    "dependencies": {
        "elm/core": "1.0.5 <= v < 2.0.0",
        "elm/json": "1.1.4 <= v < 2.0.0",
        "elm/time": "1.0.0 <= v < 2.0.0",
        "ralphtq/elm-rdf": "1.0.0 <= v < 2.0.0",
        "ralphtq/elm-rdf-n3-quads": "1.0.0 <= v < 2.0.0"
